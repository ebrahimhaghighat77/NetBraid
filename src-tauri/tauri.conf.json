{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetBraid",
  "mainBinaryName": "netbraid",
  "version": "0.1.0",
  "identifier": "ir.scidev.netbraid",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "NetBraid",
        "width": 360,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SciDev",
    "copyright": "Copyright (c) 2026 Ebi, SciDev",
    "category": "Utility",
    "shortDescription": "Combine every internet connection on your PC",
    "longDescription": "NetBraid uses Wi-Fi, Ethernet and a USB-tethered phone at the same time. Each new connection goes out on the network with the most room, so apps that open many connections get the combined speed.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/wintun.dll", "resources/wintun-LICENSE.txt"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
